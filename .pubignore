# Exclude build artifacts and IDE files from published pub.dev archive to minimize package size
.idea/
*.iml
.metadata
.flutter-plugins-dependencies
.dart_tool/
build/

# iOS workspace build caches
ios/Runner.xcworkspace/
ios/Runner.xcodeproj/project.xcworkspace/
ios/Runner.xcodeproj/xcuserdata/
ios/Pods/

# Android build caches and wrapper binaries
android/.gradle/
android/app/build/
android/gradlew
android/gradlew.bat
android/gradle/
